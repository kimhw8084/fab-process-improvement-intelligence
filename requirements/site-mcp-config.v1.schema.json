{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabintel:p4:site-mcp-config:1.0.0",
  "title": "P4 Configurable MCP Site Adapter",
  "description": "Site-owned configuration. This schema contains no tool names, source semantics, permissions, or approved server mappings.",
  "type": "object",
  "required": ["config_version", "environment", "qualification_status", "transport", "approved_source_ids", "approved_semantic_versions", "operations"],
  "properties": {
    "config_version": {"const": "1.0.0"},
    "environment": {"enum": ["INTERNAL_APPROVED_ONLY", "SYNTHETIC_TEST_ONLY"]},
    "qualification_status": {"enum": ["PENDING_INTERNAL", "QUALIFIED_INTERNAL"]},
    "site_approval_reference": {"type": "string"},
    "approved_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "approved_semantic_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "qualification_inputs": {"type": "object", "properties": {
      "semantic_version": {"type": "string"}, "permission_scope": {"type": "string"},
      "typed_entity_ids": {"type": "array", "items": {"type": "string"}}, "time_window": {"type": "object"},
      "approved_plan": {"type": "object"}, "permission_context": {"type": "object"},
      "limits": {"type": "object"}, "cancel_operation_id": {"type": "string"}
    }, "additionalProperties": false},
    "transport": {"oneOf": [{"$ref": "#/$defs/stdio"}, {"$ref": "#/$defs/http"}]},
    "operations": {"type": "object", "properties": {
      "discover": {"$ref": "#/$defs/operation"}, "semantics": {"$ref": "#/$defs/operation"},
      "relationships": {"$ref": "#/$defs/operation"}, "read_bounded": {"$ref": "#/$defs/operation"},
      "cancel": {"$ref": "#/$defs/operation"}, "audit": {"$ref": "#/$defs/operation"}
    }, "additionalProperties": false}
  },
  "allOf": [{"if": {"properties": {"environment": {"const": "INTERNAL_APPROVED_ONLY"}, "qualification_status": {"const": "QUALIFIED_INTERNAL"}}, "required": ["environment", "qualification_status"]},
             "then": {"required": ["site_approval_reference"], "properties": {"site_approval_reference": {"minLength": 1}, "approved_source_ids": {"minItems": 1}, "approved_semantic_versions": {"minItems": 1}}}},
            {"if": {"properties": {"environment": {"const": "SYNTHETIC_TEST_ONLY"}}, "required": ["environment"]},
             "then": {"properties": {"qualification_status": {"const": "PENDING_INTERNAL"}}}}],
  "additionalProperties": false,
  "$defs": {
    "stdio": {"type": "object", "required": ["type", "command"], "properties": {
      "type": {"const": "stdio"}, "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "cwd": {"type": "string"}, "env_from": {"type": "object",
        "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "additionalProperties": {"type": "string", "minLength": 1}},
      "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30}
    }, "additionalProperties": false},
    "http": {"type": "object", "required": ["type", "endpoint", "allowed_hosts"], "properties": {
      "type": {"const": "streamable_http"}, "endpoint": {"type": "string", "format": "uri"},
      "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "bearer_token_env": {"type": "string"}, "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30}
    }, "additionalProperties": false},
    "operation": {"type": "object", "required": ["tool_name", "input_map", "result_map"], "properties": {
      "tool_name": {"type": "string", "minLength": 1}, "input_map": {"type": "object", "additionalProperties": {"type": "string"}},
      "fixed_arguments": {"type": "object"}, "result_map": {"type": "object", "additionalProperties": {"type": "string"}}
    }, "additionalProperties": false}
  }
}

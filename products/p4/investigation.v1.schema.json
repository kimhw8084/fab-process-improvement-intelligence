{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabintel:p4:investigation:1.0.0",
  "title": "P4 Synthetic Investigation Request",
  "description": "Product-specific request wrapper. Real internal MCP payloads require an authorized connector and are not accepted by this synthetic build.",
  "type": "object",
  "required": ["objective", "context", "constraints_approved", "factors", "metrics", "observations", "grain", "sampling_unit", "timestamp_semantics"],
  "properties": {
    "objective": {"type": "string", "maxLength": 2000},
    "context": {"type": "object"},
    "constraints_approved": {"const": true},
    "factors": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/factor"}},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "primary_metric": {"type": "string"},
    "objectives": {"type": "array", "items": {"type": "object", "required": ["metric", "direction"], "properties": {"metric": {"type": "string"}, "direction": {"enum": ["maximize", "minimize"]}}, "additionalProperties": false}},
    "observations": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/observation"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "robustness": {"type": "object", "properties": {"min_independent_units": {"type": "integer", "minimum": 2}, "independent_unit_field": {"type": "string"}}, "additionalProperties": false},
    "forbidden_regions": {"type": "array", "items": {"type": "object"}},
    "experiment_design": {"type": "object"},
    "effectiveness": {"type": "object"},
    "validation_split": {"type": "object"},
    "multi_step": {"type": "boolean"},
    "linkage": {"type": "object"},
    "model": {"type": "object"},
    "grain": {"type": "string"},
    "sampling_unit": {"type": "string"},
    "timestamp_semantics": {"type": "string"},
    "mode": {"const": "SYNTHETIC_DEMO"},
    "request_actuation": {"type": "boolean"},
    "request_recipe_change": {"type": "boolean"}
  },
  "additionalProperties": false,
  "$defs": {
    "factor": {
      "type": "object", "required": ["name", "role", "unit"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"enum": ["controllable", "measured", "latent_unknown"]},
        "unit": {"type": "string"},
        "bounds": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "approved": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object", "required": ["name", "unit", "direction"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "unit": {"type": "string"},
        "direction": {"enum": ["maximize", "minimize"]}, "min": {"type": "number"}, "max": {"type": "number"}
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object", "required": ["factors", "metrics"],
      "properties": {"id": {"type": "string"}, "factors": {"type": "object"}, "metrics": {"type": "object"}, "wafer_id": {"type": "string"}, "lot_id": {"type": "string"}, "event_ts": {"type": "string"}},
      "additionalProperties": true
    },
    "source": {
      "type": "object", "required": ["id", "approved_semantic_version", "grain", "source_hash"],
      "properties": {"id": {"type": "string", "pattern": "^SYN-"}, "approved_semantic_version": {"type": "string", "pattern": "^SYNTHETIC-"}, "grain": {"type": "string"}, "source_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "permissions_ref": {"type": "string"}, "observed_at": {"type": "string"}},
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabintel:p4:investigation:1.0.0",
  "title": "P4 Synthetic Investigation Request",
  "description": "Product-specific request wrapper. Real internal MCP payloads require an authorized connector and are not accepted by this synthetic build.",
  "type": "object",
  "required": ["objective", "context", "constraints_approved", "factors", "metrics", "observations", "grain", "sampling_unit", "timestamp_semantics"],
  "properties": {
    "objective": {"type": "string", "maxLength": 2000},
    "context": {"type": "object"},
    "constraints_approved": {"const": true},
    "factors": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/factor"}},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "primary_metric": {"type": "string"},
    "objectives": {"type": "array", "items": {"type": "object", "required": ["metric", "direction"], "properties": {"metric": {"type": "string"}, "direction": {"enum": ["maximize", "minimize"]}}, "additionalProperties": false}},
    "familywise_mean_bounds": {
      "type": "object",
      "required": ["precommit_reference", "bounds_source_reference", "candidate_setting_ids", "metric_units", "metric_bounds"],
      "properties": {
        "precommit_reference": {"type": "string", "minLength": 1},
        "bounds_source_reference": {"type": "string", "minLength": 1},
        "candidate_setting_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "metric_units": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "metric_bounds": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
        }
      },
      "additionalProperties": false
    },
    "familywise_t_precommit": {
      "type": "object",
      "required": ["precommit_reference", "candidate_setting_ids", "objectives"],
      "properties": {
        "precommit_reference": {"type": "string", "minLength": 1},
        "candidate_setting_ids": {"type": "array", "minItems": 2, "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "objectives": {"type": "array", "minItems": 2, "maxItems": 10, "uniqueItems": true,
          "items": {"type": "object", "required": ["metric", "direction"],
            "properties": {"metric": {"type": "string", "minLength": 1}, "direction": {"enum": ["maximize", "minimize"]}},
            "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "observations": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/observation"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "robustness": {"type": "object", "properties": {"min_independent_units": {"type": "integer", "minimum": 2}, "independent_unit_field": {"type": "string"}}, "additionalProperties": false},
    "forbidden_regions": {"type": "array", "items": {"type": "object"}},
    "experiment_design": {
      "type": "object",
      "properties": {
        "strategy": {"enum": ["full_factorial", "fractional_factorial", "central_composite", "latin_hypercube", "d_optimal", "next_best", "next_best_multiobjective", "confirm_window_candidate"]},
        "run_budget": {"type": "integer", "minimum": 1}, "replicates": {"type": "integer", "minimum": 1},
        "blocks": {"type": "integer", "minimum": 1}, "seed": {"type": "integer"},
        "center_replicates": {"type": "integer", "minimum": 2, "maximum": 100},
        "candidate_levels": {"type": "integer", "minimum": 2, "maximum": 41},
        "target_metric": {"type": "string"}, "independent_unit_field": {"type": "string"},
        "validation_time_split": {
          "type": "object",
          "required": ["timestamp_field", "training_end", "evaluation_start", "split_reference"],
          "properties": {
            "timestamp_field": {"type": "string", "minLength": 1},
            "training_end": {"type": "string", "format": "date-time"},
            "evaluation_start": {"type": "string", "format": "date-time"},
            "split_reference": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "constraint_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "min_independent_units": {"type": "integer", "minimum": 3}, "fixed_effects": {"type": "object"},
        "maximum_grouped_validation_rmse": {"type": "number", "exclusiveMinimum": 0},
        "maximum_grouped_validation_rmse_by_metric": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
        "noise_sd": {"type": "number", "exclusiveMinimum": 0},
        "minimum_detectable_effect": {"type": "number", "exclusiveMinimum": 0},
        "candidate_factors": {"type": "object", "additionalProperties": {"type": "number"}},
        "comparison_factors": {"type": "object", "additionalProperties": {"type": "number"}},
        "objective_statement": {"type": "string", "minLength": 1},
        "paired_difference_sd": {"type": "number", "exclusiveMinimum": 0},
        "paired_difference_sd_source": {"type": "string", "minLength": 1},
        "paired_difference_sd_basis": {"enum": ["ONE_SIDED_CHI_SQUARE_UPPER_CONFIDENCE_BOUND", "ENGINEER_APPROVED_HARD_BOUND"]},
        "paired_difference_sd_confidence_level": {"type": "number", "minimum": 0.95, "exclusiveMaximum": 1},
        "paired_difference_sd_degrees_of_freedom": {"type": "integer", "minimum": 2},
        "minimum_detectable_effect_source": {"type": "string", "minLength": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.2},
        "target_power": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 0.99}
      },
      "additionalProperties": false
    },
    "window_exploration": {
      "type": "object",
      "required": ["calibration"],
      "properties": {
        "factors": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "fixed_settings": {"type": "object", "additionalProperties": {"type": "number"}},
        "fixed_effects": {"type": "object"},
        "evaluation_strata": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "independent_unit_field": {"type": "string", "minLength": 1},
        "min_independent_units": {"type": "integer", "minimum": 3},
        "grid_points": {"type": "integer", "minimum": 5, "maximum": 41},
        "min_support_points": {"type": "integer", "minimum": 2},
        "max_support_radius": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "calibration": {
          "type": "object",
          "required": ["group_field", "partition_field", "training_value", "calibration_value", "split_reference"],
          "properties": {
            "group_field": {"type": "string", "minLength": 1},
            "partition_field": {"type": "string", "minLength": 1},
            "training_value": {"type": "string", "minLength": 1},
            "calibration_value": {"type": "string", "minLength": 1},
            "evaluation_value": {"type": "string", "minLength": 1},
            "split_reference": {"type": "string", "minLength": 1},
            "minimum_calibration_units": {"type": "integer", "minimum": 19},
            "precommit": {
              "type": "object",
              "required": ["plan_reference", "model_selection_reference", "threshold_selection_reference", "metric_family", "metric_bounds", "exact_setting_panel"],
              "properties": {
                "plan_reference": {"type": "string", "minLength": 1},
                "model_selection_reference": {"type": "string", "minLength": 1},
                "threshold_selection_reference": {"type": "string", "minLength": 1},
                "observations_per_setting": {"type": "integer", "minimum": 1, "maximum": 5000},
                "strata": {
                  "type": "object", "required": ["fields", "categories"],
                  "properties": {
                    "fields": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
                      "items": {"type": "string", "minLength": 1}},
                    "categories": {"type": "array", "minItems": 2, "maxItems": 100,
                      "items": {"type": "object", "minProperties": 1,
                        "additionalProperties": {"type": ["string", "number"]}}}
                  },
                  "additionalProperties": false
                },
                "metric_family": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "metric_bounds": {
                  "type": "object", "minProperties": 1,
                  "additionalProperties": {
                    "type": "object", "required": ["min", "max"],
                    "properties": {
                      "min": {"type": ["number", "null"]},
                      "max": {"type": ["number", "null"]}
                    },
                    "additionalProperties": false
                  }
                },
                "exact_setting_panel": {
                  "type": "array", "minItems": 1, "maxItems": 1681,
                  "items": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "effectiveness": {
      "type": "object",
      "properties": {
        "authorized": {"type": "boolean"}, "design": {"enum": ["randomized", "difference_in_differences", "before_after"]},
        "metric": {"type": "string"}, "metric_unit": {"type": "string", "minLength": 1},
        "intervention_time": {"type": "string", "format": "date-time", "description": "Timezone-aware intervention cutoff required for DiD timing verification."},
        "observations": {"type": "array", "items": {"type": "object", "properties": {
          "timestamp": {"type": "string", "format": "date-time", "description": "Timezone-aware observation time required for DiD timing verification."}}}},
        "assignment_ledger": {"type": "array", "items": {"type": "object", "required": ["unit_id", "group"],
          "properties": {"unit_id": {"type": "string"}, "group": {"enum": ["treatment", "control"]},
            "shared_groups": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
        "outcome_bounds": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "baseline_covariates": {"type": "array", "items": {"type": "string"}},
        "population_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "shared_dependence_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1},
          "description": "Caller-declared time-invariant row fields such as chamber or tool. Repeated values across units withhold unit-level Welch uncertainty. When a randomized outcome is missing, assignment-ledger entries must include matching values in shared_groups. Omission or unique values do not prove independence."},
        "randomization_cluster_field": {"type": "string", "minLength": 1,
          "description": "Optional explicit randomization cluster field for a randomized study. Must also appear in shared_dependence_fields and in every assignment-ledger shared_groups entry. P4 analyzes equal-weight cluster means and reports per-arm cluster-size summaries; it does not estimate a lot-weighted effect when cluster sizes differ. Complete outcomes and at least five independent clusters per arm are required, with normality/exchangeability limitations; this threshold is not a universal guarantee."},
        "differential_trend_bound": {"type": "number", "minimum": 0},
        "differential_trend_bound_source": {"type": "string", "minLength": 1},
        "differential_trend_bound_method": {"type": "string", "minLength": 1},
        "differential_trend_bound_unit": {"type": "string", "minLength": 1},
        "pretrend_equivalence_bound": {"type": "number", "minimum": 0},
        "pretrend_equivalence_bound_source": {"type": "string", "minLength": 1},
        "pretrend_equivalence_bound_method": {"type": "string", "minLength": 1},
        "pretrend_equivalence_bound_unit": {"type": "string", "minLength": 1},
        "negative_control_outcome": {"type": "object", "required": ["metric", "equivalence_bound", "bound_unit", "bound_source", "bound_method"],
          "properties": {"metric": {"type": "string", "minLength": 1}, "equivalence_bound": {"type": "number", "minimum": 0},
            "bound_unit": {"type": "string", "minLength": 1},
            "bound_source": {"type": "string", "minLength": 1}, "bound_method": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "differential_concurrent_intervention": {"type": "boolean"},
        "intervention_id": {"type": "string"}, "authorization_id": {"type": "string"},
        "randomization_evidence": {"type": "string"}
      },
      "additionalProperties": true
    },
    "validation_split": {"type": "object"},
    "multi_step": {"type": "boolean"},
    "linkage": {"oneOf": [{"$ref": "#/$defs/relationship_contract_v1"},
                             {"$ref": "#/$defs/relationship_contract_v1_1"}]},
    "model": {
      "type": "object",
      "properties": {
        "factor_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "covariance": {"enum": ["HC3", "cluster", "classical"]},
        "cluster_field": {"type": "string", "minLength": 1},
        "minimum_clusters": {"type": "integer", "minimum": 10},
        "shared_dependence_fields": {"type": "array", "uniqueItems": true, "description": "Caller-declared row fields that may share residual shocks across independent units. P4 checks group overlap only; it does not infer whether dependence exists or detect undeclared sources.", "items": {"type": "string", "minLength": 1}},
        "fixed_effect_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "adjustment_sensitivity_fields": {"type": "array", "maxItems": 16, "uniqueItems": true, "description": "Optional caller-nominated measured row fields compared one at a time as same-sample adjustment sensitivity checks. These fields are not inferred or selected by P4 and do not establish confounding or causal effects.", "items": {"type": "string", "minLength": 1}},
        "fixed_effect_interactions": {"type": "array", "uniqueItems": true, "items": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}},
        "max_fixed_effect_levels": {"type": "integer", "minimum": 2, "maximum": 100},
        "interactions": {"oneOf": [{"type": "boolean"}, {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}}]},
        "quadratic": {"oneOf": [{"type": "boolean"}, {"type": "array", "uniqueItems": true, "items": {"type": "string"}}]}
      },
      "additionalProperties": false
    },
    "grain": {"type": "string"},
    "sampling_unit": {"type": "string"},
    "timestamp_semantics": {"type": "string"},
    "mode": {"const": "SYNTHETIC_DEMO"},
    "request_actuation": {"type": "boolean"},
    "request_recipe_change": {"type": "boolean"}
  },
  "additionalProperties": false,
  "$defs": {
    "factor": {
      "type": "object", "required": ["name", "role", "unit"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"enum": ["controllable", "measured", "latent_unknown"]},
        "unit": {"type": "string"},
        "bounds": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "approved": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object", "required": ["name", "unit", "direction"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "unit": {"type": "string"},
        "direction": {"enum": ["maximize", "minimize"]}, "min": {"type": "number"}, "max": {"type": "number"}
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object", "required": ["factors", "metrics"],
      "properties": {"id": {"type": "string"}, "unit_id": {"type": "string", "minLength": 1}, "factors": {"type": "object"}, "metrics": {"type": "object"}, "wafer_id": {"type": "string"}, "lot_id": {"type": "string"}, "event_ts": {"type": "string"}},
      "additionalProperties": true
    },
    "source": {
      "type": "object", "required": ["id", "approved_semantic_version", "grain", "source_hash"],
      "properties": {"id": {"type": "string", "pattern": "^SYN-"}, "approved_semantic_version": {"type": "string", "pattern": "^SYNTHETIC-"}, "grain": {"type": "string"}, "source_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "permissions_ref": {"type": "string"}, "observed_at": {"type": "string"}},
      "additionalProperties": false
    },
    "relationship_step": {
      "type": "object", "required": ["source_id", "key_field", "event_time_field", "population_field", "population_id", "metric_field", "metric"],
      "properties": {"source_id": {"type": "string", "pattern": "^SYN-"}, "key_field": {"type": "string"},
        "event_time_field": {"type": "string"}, "population_field": {"type": "string"},
        "population_id": {"type": "string"}, "metric_field": {"type": "string"}, "metric": {"type": "string"}},
      "additionalProperties": false
    },
    "relationship_contract_v1": {
      "type": "object", "required": ["approved", "relationship_id", "contract_version", "approval_reference", "upstream", "downstream", "maximum_lag_seconds", "unit_field", "decision_factors"],
      "properties": {"approved": {"const": true}, "relationship_id": {"type": "string", "pattern": "^SYN-"},
        "contract_version": {"const": "1.0.0"}, "approval_reference": {"type": "string", "pattern": "^SYN-"},
        "upstream": {"$ref": "#/$defs/relationship_step"}, "downstream": {"$ref": "#/$defs/relationship_step"},
        "maximum_lag_seconds": {"type": "number", "exclusiveMinimum": 0}, "unit_field": {"type": "string"},
        "decision_factors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "minimum_independent_units": {"type": "integer", "minimum": 3}},
      "additionalProperties": false
    },
    "relationship_contract_v1_1": {
      "type": "object", "required": ["approved", "relationship_id", "contract_version", "approval_reference", "upstream", "downstream", "maximum_lag_seconds", "unit_field", "decision_factors", "population_composition_fields"],
      "properties": {"approved": {"const": true}, "relationship_id": {"type": "string", "pattern": "^SYN-"},
        "contract_version": {"const": "1.1.0"}, "approval_reference": {"type": "string", "pattern": "^SYN-"},
        "upstream": {"$ref": "#/$defs/relationship_step"}, "downstream": {"$ref": "#/$defs/relationship_step"},
        "maximum_lag_seconds": {"type": "number", "exclusiveMinimum": 0}, "unit_field": {"type": "string"},
        "decision_factors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "population_composition_fields": {"type": "array", "minItems": 1, "uniqueItems": true,
          "description": "Approved upstream/downstream categorical mappings used to verify comparable per-setting stratum proportions before a cross-step Pareto comparison.",
          "items": {"type": "object", "required": ["name", "upstream_field", "downstream_field"],
            "properties": {"name": {"type": "string", "minLength": 1},
              "upstream_field": {"type": "string", "minLength": 1},
              "downstream_field": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "minimum_independent_units": {"type": "integer", "minimum": 3}},
      "additionalProperties": false
    }
  }
}

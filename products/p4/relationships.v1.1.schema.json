{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabintel:p4:relationship-contract:1.1.0",
  "title": "P4 Cross-step Relationship Contract",
  "description": "Explicit field, cohort, key, time, population-composition, and objective mapping. SYN references qualify offline behavior only and confer no company approval.",
  "type": "object",
  "required": ["approved", "relationship_id", "contract_version", "approval_reference", "upstream", "downstream", "maximum_lag_seconds", "unit_field", "decision_factors", "population_composition_fields"],
  "properties": {
    "approved": {"const": true},
    "relationship_id": {"type": "string", "pattern": "^SYN-"},
    "contract_version": {"const": "1.1.0"},
    "approval_reference": {"type": "string", "pattern": "^SYN-"},
    "upstream": {"$ref": "#/$defs/step"},
    "downstream": {"$ref": "#/$defs/step"},
    "maximum_lag_seconds": {"type": "number", "exclusiveMinimum": 0},
    "unit_field": {"type": "string", "minLength": 1},
    "decision_factors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "population_composition_fields": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "description": "Approved upstream/downstream categorical mappings used to verify comparable per-setting stratum proportions before a cross-step Pareto comparison.",
      "items": {"type": "object", "required": ["name", "upstream_field", "downstream_field"],
        "properties": {"name": {"type": "string", "minLength": 1},
          "upstream_field": {"type": "string", "minLength": 1},
          "downstream_field": {"type": "string", "minLength": 1}},
        "additionalProperties": false}
    },
    "minimum_independent_units": {"type": "integer", "minimum": 3}
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["source_id", "key_field", "event_time_field", "population_field", "population_id", "metric_field", "metric"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SYN-"},
        "key_field": {"type": "string", "minLength": 1},
        "event_time_field": {"type": "string", "minLength": 1},
        "population_field": {"type": "string", "minLength": 1},
        "population_id": {"type": "string", "minLength": 1},
        "metric_field": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
